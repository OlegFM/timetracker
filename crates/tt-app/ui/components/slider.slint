import { Theme } from "../theme.slint";
import { FocusRing } from "button.slint";

// Horizontal slider over whole numbers from `minimum` to `maximum` in steps of `step`.
// It shows `value` and calls `edited` with the new value while it is dragged, clicked or
// moved with the keys (←/→ by one step, Home/End to the ends); the owner stores it and
// writes it back into `value`.
export component Slider inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    callback edited(value: int);

    private property <length> thumb: 16px;
    private property <float> fraction: root.maximum > root.minimum ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0;

    function set-to(wanted: int) {
        let v = Math.max(root.minimum, Math.min(root.maximum, wanted));
        if v != root.value {
            root.edited(v);
        }
    }

    // The value under the x position (a pointer in the track).
    function set-from-x(x: length) {
        let f = Math.max(0, Math.min(1, (x - root.thumb / 2) / (root.width - root.thumb)));
        let raw = root.minimum + f * (root.maximum - root.minimum);
        root.set-to(root.minimum + Math.round((raw - root.minimum) / root.step) * root.step);
    }

    height: 24px;
    min-width: 120px;
    forward-focus: keys;

    accessible-role: slider;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.line;

        Rectangle {
            x: 0;
            width: root.thumb / 2 + root.fraction * (root.width - root.thumb);
            border-radius: 2px;
            background: Theme.accent;
        }
    }

    Rectangle {
        x: root.fraction * (root.width - self.width);
        y: (parent.height - self.height) / 2;
        width: root.thumb;
        height: root.thumb;
        border-radius: root.thumb / 2;
        background: Theme.accent;
        border-width: 2px;
        border-color: Theme.card;
    }

    keys := FocusScope {
        property <bool> focus-visible;

        focus-gained(reason) => {
            self.focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            self.focus-visible = false;
        }
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.set-to(root.value - root.step);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.set-to(root.value + root.step);
                return accept;
            }
            if event.text == Key.Home {
                root.set-to(root.minimum);
                return accept;
            }
            if event.text == Key.End {
                root.set-to(root.maximum);
                return accept;
            }
            reject
        }

        TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.set-from-x(self.mouse-x);
                }
            }
            moved => {
                if self.pressed {
                    root.set-from-x(self.mouse-x);
                }
            }
        }

        if keys.focus-visible: FocusRing {
            radius: root.height / 2;
        }
    }
}
