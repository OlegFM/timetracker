import { Theme } from "../theme.slint";
import { ChartTip } from "card.slint";

// One bar: `value` is 0..1 of the largest bar; `caption` is shown on hover.
export struct BarView {
    label: string,
    value: float,
    caption: string,
}

// Vertical bars with a label under each; hovering a column shows its caption.
export component BarChart inherits Rectangle {
    in property <[BarView]> bars;

    private property <int> hover: -1;
    private property <length> label-height: 18px;
    private property <length> column: root.bars.length > 0 ? root.width / root.bars.length : root.width;

    min-height: 80px;
    accessible-role: list;

    for bar[i] in root.bars: Rectangle {
        x: i * root.column;
        width: root.column;
        height: root.height;
        accessible-role: list-item;
        accessible-label: bar.label + ": " + bar.caption;

        // Bar area above the label.
        Rectangle {
            height: parent.height - root.label-height - Theme.gap-2;
            width: min(parent.width - Theme.gap-2, 40px);
            x: (parent.width - self.width) / 2;

            Rectangle {
                width: parent.width;
                height: bar.value > 0 ? max(3px, parent.height * bar.value) : 2px;
                y: parent.height - self.height;
                border-radius: 2px;
                background: bar.value > 0 ? Theme.accent : Theme.line;
                opacity: root.hover == -1 || root.hover == i ? 1 : 0.6;
            }
        }
        Text {
            y: parent.height - root.label-height;
            width: parent.width;
            height: root.label-height;
            text: bar.label;
            color: root.hover == i ? Theme.text : Theme.muted;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        TouchArea {
            changed has-hover => {
                if self.has-hover {
                    root.hover = i;
                } else if root.hover == i {
                    root.hover = -1;
                }
            }
        }
    }

    if root.hover >= 0 && root.hover < root.bars.length: ChartTip {
        text: root.bars[root.hover].caption;
        x: max(0px, min(root.width - self.width, (root.hover + 0.5) * root.column - self.width / 2));
        y: max(0px, (root.height - root.label-height) * (1 - root.bars[root.hover].value) - self.height - Theme.gap-1);
    }
}
