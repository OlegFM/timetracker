import { Theme } from "theme.slint";
import { Tr } from "strings.slint";
import { Sidebar } from "components/sidebar.slint";
import { Toast, ToastKind } from "components/toast.slint";
import { PlaceholderScreen } from "screens/placeholder.slint";
import { TimeScreen } from "screens/time.slint";
import { EntryDialog } from "components/entry_dialog.slint";
import { TimerBar } from "components/timer_bar.slint";
import { TimerBridge, TimerView } from "bridges/timer.slint";
import { Pickers, ProjectOption, TagOption } from "bridges/pickers.slint";
import { EntriesBridge, DayView, EntryRowView, EntryDialogData, EntryDialogView } from "bridges/entries.slint";
import { Calendar, CalendarDay, CalendarMonth } from "bridges/calendar.slint";
import { ConfirmDialog } from "components/dialog.slint";
import { MiniBridge } from "bridges/mini.slint";
import { MiniTimer } from "mini_timer.slint";

// Globals and enums used from Rust must be exported from the main file.
export { Theme, Tr, ToastKind, TimerBridge, TimerView, Pickers, ProjectOption, TagOption }
export { EntriesBridge, DayView, EntryRowView, EntryDialogData, EntryDialogView }
export { Calendar, CalendarDay, CalendarMonth }
export { MiniBridge, MiniTimer }

export component MainWindow inherits Window {
    // Page index: 0 Dashboard, 1 Time, 2 Projects, 3 Project, 4 Clients, 5 Tags,
    // 6 Reports, 7 Settings.
    in-out property <int> page: 0;
    // Entry waiting for the delete confirmation; empty = none.
    property <string> delete-id;

    public function show-toast(text: string, kind: ToastKind) {
        toast.show(text, kind);
    }

    title: "TimeTracker";
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1200px;
    preferred-height: 760px;
    default-font-family: "Segoe UI";
    background: Theme.bg;

    HorizontalLayout {
        Sidebar {
            current <=> root.page;
        }

        VerticalLayout {
            TimerBar { }

            VerticalLayout {
                if root.page == 0: PlaceholderScreen {
                    title: @tr("Dashboard");
                }
                if root.page == 1: TimeScreen {
                    request-delete(id) => { root.delete-id = id; }
                }
                if root.page == 2: PlaceholderScreen {
                    title: @tr("Projects");
                }
                if root.page == 3: PlaceholderScreen {
                    title: @tr("Project");
                }
                if root.page == 4: PlaceholderScreen {
                    title: @tr("Clients");
                }
                if root.page == 5: PlaceholderScreen {
                    title: @tr("Tags");
                }
                if root.page == 6: PlaceholderScreen {
                    title: @tr("Reports");
                }
                if root.page == 7: PlaceholderScreen {
                    title: @tr("Settings");
                }
            }
        }
    }

    if EntriesBridge.dialog-open: EntryDialog {
        view: EntriesBridge.dialog;
        closed => { EntriesBridge.dialog-open = false; }
    }

    if root.delete-id != "": ConfirmDialog {
        title: @tr("Delete this time entry?");
        message: @tr("The entry will be removed permanently.");
        confirm-text: @tr("Delete");
        confirmed => {
            EntriesBridge.delete(root.delete-id);
            root.delete-id = "";
        }
        cancelled => { root.delete-id = ""; }
    }

    toast := Toast {
        x: parent.width - self.width - Theme.gap-5;
        y: parent.height - self.height - Theme.gap-5;
    }
}
