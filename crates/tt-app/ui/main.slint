import { Theme } from "theme.slint";
import { Tr } from "strings.slint";
import { Sidebar } from "components/sidebar.slint";
import { Toast, ToastKind } from "components/toast.slint";
import { TimeScreen } from "screens/time.slint";
import { ProjectsScreen } from "screens/projects.slint";
import { ProjectScreen } from "screens/project.slint";
import { ClientsScreen } from "screens/clients.slint";
import { TagsScreen } from "screens/tags.slint";
import { DashboardScreen } from "screens/dashboard.slint";
import { ReportsScreen } from "screens/reports.slint";
import { SettingsScreen } from "screens/settings.slint";
import { ProjectDialog, TaskDialog } from "components/project_dialog.slint";
import { EntryDialog } from "components/entry_dialog.slint";
import { TimerBar } from "components/timer_bar.slint";
import { TimerBridge, TimerView } from "bridges/timer.slint";
import { Pickers, ProjectOption, TagOption } from "bridges/pickers.slint";
import { EntriesBridge, DayView, EntryRowView, EntryDialogData, EntryDialogView } from "bridges/entries.slint";
import { Calendar, CalendarDay, CalendarMonth } from "bridges/calendar.slint";
import { CatalogBridge, ProjectRowView, TaskRowView, ClientRowView, TagRowView, ProjectDialogData, TaskDialogData, CatalogKind, DeleteRequest } from "bridges/catalog.slint";
import { ConfirmDialog } from "components/dialog.slint";
import { MiniBridge } from "bridges/mini.slint";
import { SettingsBridge } from "bridges/settings.slint";
import { DashboardBridge, RecentView, ProjectTotalView } from "bridges/dashboard.slint";
import { BarView } from "components/bar_chart.slint";
import { HeatCell } from "components/heatmap.slint";
import { PieSlice } from "components/pie_chart.slint";
import { ReportsBridge, ReportRowView, FilterView } from "bridges/reports.slint";
import { SelectLabels, SelectOption } from "components/select.slint";
import { MiniTimer } from "mini_timer.slint";

// Globals and enums used from Rust must be exported from the main file.
export { Theme, Tr, ToastKind, TimerBridge, TimerView, Pickers, ProjectOption, TagOption }
export { EntriesBridge, DayView, EntryRowView, EntryDialogData, EntryDialogView }
export { Calendar, CalendarDay, CalendarMonth }
export { CatalogBridge, ProjectRowView, TaskRowView, ClientRowView, TagRowView, ProjectDialogData, TaskDialogData, CatalogKind, DeleteRequest }
export { MiniBridge, MiniTimer, SettingsBridge }
export { DashboardBridge, RecentView, ProjectTotalView, BarView, HeatCell, PieSlice }
export { ReportsBridge, ReportRowView, FilterView, SelectLabels, SelectOption }

export component MainWindow inherits Window {
    // Page index: 0 Dashboard, 1 Time, 2 Projects, 3 Project, 4 Clients, 5 Tags,
    // 6 Reports, 7 Settings.
    in-out property <int> page: 0;
    // Entry waiting for the delete confirmation; empty = none.
    property <string> delete-id;
    // Catalog item waiting for the delete confirmation; empty id = none.
    property <DeleteRequest> catalog-delete;

    public function show-toast(text: string, kind: ToastKind) {
        toast.show(text, kind);
    }

    title: "TimeTracker";
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1200px;
    preferred-height: 760px;
    default-font-family: Tr.font-family;
    background: Theme.bg;

    HorizontalLayout {
        Sidebar {
            current <=> root.page;
        }

        VerticalLayout {
            TimerBar { }

            VerticalLayout {
                if root.page == 0: DashboardScreen { }
                if root.page == 1: TimeScreen {
                    request-delete(id) => { root.delete-id = id; }
                }
                if root.page == 2: ProjectsScreen {
                    open(id) => {
                        CatalogBridge.open-project(id);
                        root.page = 3;
                    }
                    request-delete(request) => { root.catalog-delete = request; }
                }
                if root.page == 3: ProjectScreen {
                    back => { root.page = 2; }
                    request-delete(request) => { root.catalog-delete = request; }
                }
                if root.page == 4: ClientsScreen {
                    request-delete(request) => { root.catalog-delete = request; }
                }
                if root.page == 5: TagsScreen {
                    request-delete(request) => { root.catalog-delete = request; }
                }
                if root.page == 6: ReportsScreen { }
                if root.page == 7: SettingsScreen { }
            }
        }
    }

    if EntriesBridge.dialog-open: EntryDialog {
        view: EntriesBridge.dialog;
        closed => { EntriesBridge.dialog-open = false; }
    }

    if root.delete-id != "": ConfirmDialog {
        title: @tr("Delete this time entry?");
        message: @tr("The entry will be removed permanently.");
        confirm-text: @tr("Delete");
        confirmed => {
            EntriesBridge.delete(root.delete-id);
            root.delete-id = "";
        }
        cancelled => { root.delete-id = ""; }
    }

    if CatalogBridge.project-dialog-open: ProjectDialog {
        data: CatalogBridge.project-dialog;
        closed => { CatalogBridge.project-dialog-open = false; }
    }

    if CatalogBridge.task-dialog-open: TaskDialog {
        data: CatalogBridge.task-dialog;
        closed => { CatalogBridge.task-dialog-open = false; }
    }

    if root.catalog-delete.id != "": ConfirmDialog {
        title: @tr("Delete \"{}\"?", root.catalog-delete.name);
        message: root.catalog-delete.kind == CatalogKind.project ? @tr("The project will be removed permanently.")
            : root.catalog-delete.kind == CatalogKind.task ? @tr("The task will be removed permanently.")
            : root.catalog-delete.kind == CatalogKind.client ? @tr("The client will be removed permanently.")
            : root.catalog-delete.count == 0 ? @tr("The tag will be removed permanently.")
            : @tr("The tag will be removed from {n} time entry." | "The tag will be removed from {n} time entries." % root.catalog-delete.count);
        confirm-text: @tr("Delete");
        confirmed => {
            let r = root.catalog-delete;
            root.catalog-delete = { id: "" };
            if r.kind == CatalogKind.project {
                CatalogBridge.delete-project(r.id);
            } else if r.kind == CatalogKind.task {
                CatalogBridge.delete-task(r.id);
            } else if r.kind == CatalogKind.client {
                CatalogBridge.delete-client(r.id);
            } else {
                CatalogBridge.delete-tag(r.id);
            }
        }
        cancelled => { root.catalog-delete = { id: "" }; }
    }

    if SettingsBridge.restore-pending: ConfirmDialog {
        title: @tr("Restore from backup?");
        message: @tr("All current data will be replaced by the contents of the backup. A copy of the current data is kept next to the database (.before-restore).");
        confirm-text: @tr("backup" => "Restore");
        confirmed => { SettingsBridge.confirm-restore(); }
        cancelled => { SettingsBridge.cancel-restore(); }
    }

    toast := Toast {
        x: parent.width - self.width - Theme.gap-5;
        y: parent.height - self.height - Theme.gap-5;
    }
}
