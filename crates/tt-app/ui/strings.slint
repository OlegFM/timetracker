// Translated strings needed by Rust code (tray, export headers, error messages).
// Read from Rust via `ui.global::<Tr>().get_…()`; values follow the selected language.

export global Tr {
    // Tray menu
    out property <string> tray-pause: @tr("Pause");
    out property <string> tray-resume: @tr("Resume");
    out property <string> tray-stop: @tr("Stop");
    out property <string> tray-show-mini: @tr("Show mini timer");
    out property <string> tray-hide-mini: @tr("Hide mini timer");
    out property <string> tray-open: @tr("Open window");
    out property <string> tray-quit: @tr("Quit");
    out property <string> no-active-task: @tr("No active task");

    // Duration suffixes (FormatPrefs)
    out property <string> hour-suffix: @tr("h");
    out property <string> minute-suffix: @tr("min");

    // Export headers and placeholders (tt_services::ExportLabels)
    out property <string> export-group: @tr("export" => "Group");
    out property <string> export-subgroup: @tr("export" => "Subgroup");
    out property <string> export-duration: @tr("export" => "Duration");
    out property <string> export-cost: @tr("export" => "Cost");
    out property <string> export-total: @tr("export" => "Total");
    out property <string> export-no-project: @tr("export" => "No project");
    out property <string> export-no-task: @tr("export" => "No task");
    out property <string> export-no-client: @tr("export" => "No client");
    out property <string> export-no-tag: @tr("export" => "No tag");
    out property <string> export-yes: @tr("export" => "Yes");
    out property <string> export-no: @tr("export" => "No");
    out property <string> export-description: @tr("export" => "Description");
    out property <string> export-project: @tr("export" => "Project");
    out property <string> export-task: @tr("export" => "Task");
    out property <string> export-client: @tr("export" => "Client");
    out property <string> export-tags: @tr("export" => "Tags");
    out property <string> export-billable: @tr("export" => "Billable");
    out property <string> export-start: @tr("export" => "Start");
    out property <string> export-end: @tr("export" => "End");
    out property <string> export-date: @tr("export" => "Date");

    // Day titles of the time entries list
    out property <string> day-today: @tr("Today");
    out property <string> day-yesterday: @tr("Yesterday");

    // Dashboard: weekday abbreviations (Monday first) and the label of time without a project
    out property <string> weekday-mon: @tr("weekday" => "Mon");
    out property <string> weekday-tue: @tr("weekday" => "Tue");
    out property <string> weekday-wed: @tr("weekday" => "Wed");
    out property <string> weekday-thu: @tr("weekday" => "Thu");
    out property <string> weekday-fri: @tr("weekday" => "Fri");
    out property <string> weekday-sat: @tr("weekday" => "Sat");
    out property <string> weekday-sun: @tr("weekday" => "Sun");
    out property <string> no-project: @tr("No project");

    // Reports: group names, labels of empty groups, short month names, the total
    out property <string> group-project: @tr("Project");
    out property <string> group-task: @tr("Task");
    out property <string> group-client: @tr("Client");
    out property <string> group-tag: @tr("Tag");
    out property <string> group-billable: @tr("Billable");
    out property <string> group-description: @tr("Description");
    out property <string> group-day: @tr("Day");
    out property <string> group-none: @tr("None");
    out property <string> no-task: @tr("No task");
    out property <string> no-client: @tr("No client");
    out property <string> no-tag: @tr("No tag");
    out property <string> no-description: @tr("No description");
    out property <string> non-billable: @tr("Non-billable");
    out property <string> report-total: @tr("Total");
    out property <string> report-other: @tr("Other");
    out property <string> month-jan: @tr("month" => "Jan");
    out property <string> month-feb: @tr("month" => "Feb");
    out property <string> month-mar: @tr("month" => "Mar");
    out property <string> month-apr: @tr("month" => "Apr");
    out property <string> month-may: @tr("month" => "May");
    out property <string> month-jun: @tr("month" => "Jun");
    out property <string> month-jul: @tr("month" => "Jul");
    out property <string> month-aug: @tr("month" => "Aug");
    out property <string> month-sep: @tr("month" => "Sep");
    out property <string> month-oct: @tr("month" => "Oct");
    out property <string> month-nov: @tr("month" => "Nov");
    out property <string> month-dec: @tr("month" => "Dec");
    out property <string> exported: @tr("Exported");

    // Service errors (tt_services::ServiceError)
    out property <string> err-in-use-projects: @tr("Can't delete: it still has projects. Archive it instead.");
    out property <string> err-in-use-tasks: @tr("Can't delete: it still has tasks. Archive it instead.");
    out property <string> err-in-use-entries: @tr("Can't delete: it has time entries. Archive it instead.");
    out property <string> err-in-use-task-entries: @tr("Can't delete: the task has time entries. Mark it as done instead.");
    out property <string> err-overlap: @tr("This time overlaps another entry.");
    out property <string> err-invalid-name: @tr("Enter a name (up to 255 characters).");
    out property <string> err-invalid-color: @tr("Choose a valid color.");
    out property <string> err-invalid-rate: @tr("Enter an amount like 50 or 50.50.");
    out property <string> err-invalid-estimate: @tr("Enter a duration like 40 or 1:30 or 1h 30m.");
    out property <string> err-invalid-range: @tr("The end must be after the start.");
    out property <string> err-backup: @tr("This file is not a valid TimeTracker backup.");
    out property <string> err-start-future: @tr("The start can't be in the future.");
    out property <string> err-generic: @tr("Something went wrong. Please try again.");
}
